# Copy this file to .env.production and replace every CHANGE_ME value.
# Never commit .env.production.
APP_ENV=production
MAX_UPLOAD_MB=500
MODEL_STORAGE_PATH=/app/data/uploads
CACHE_STORAGE_PATH=/app/data/cache
OCR_OUTPUT_DIR=/app/data/ocr
OCR_MAX_WORKERS=2
DB_INIT_ASYNC=0
DB_INIT_ON_STARTUP=1
DB_INIT_MAX_RETRIES=15
DB_INIT_RETRY_DELAY_SECONDS=3

# Public site and CORS
HDMS_PUBLIC_ORIGIN=https://hdmsurban.com
CORS_ORIGINS=https://hdmsurban.com,https://www.hdmsurban.com
CORS_ALLOW_PRIVATE_ORIGINS=0
NEXT_PUBLIC_HDMS_API_BASE=
NEXT_PUBLIC_HDMS_QA_BASE=
NEXT_PUBLIC_DATA_PROCESS_BASE=

# Application model providers
HDMS_BASE_URL=CHANGE_ME
HDMS_API_KEY=CHANGE_ME
HDMS_QA_MODEL=CHANGE_ME
HDMS_KG_MODEL=CHANGE_ME
HDMS_CHECK_LIST_MODEL=CHANGE_ME
HDMS_VISION_MODEL=CHANGE_ME
MINERU_API_KEY=CHANGE_ME
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072
RERANK_ENABLED=false
RERANK_BASE_URL=CHANGE_ME
RERANK_API_KEY=CHANGE_ME
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TOP_N=5
MILVUS_COLLECTION_TEXT=hdms_text_chunks
MILVUS_RECREATE_ON_MISMATCH=0
MILVUS_DIMENSION_STRICT=1
STREAM_ENABLE_RERANK=0
STREAM_RETRIEVAL_MODE=hybrid
STREAM_RETRIEVAL_TOP_K_CAP=20

# Internal service addresses. Keep hostnames unchanged.
MILVUS_HOST=milvus
MILVUS_PORT=19530
MONGODB_DATABASE=hdms
MONGODB_URI=mongodb://hdms:CHANGE_ME@mongodb:27017/hdms?authSource=admin
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# Infrastructure credentials: generate strong, unique values.
POSTGRES_USER=hdms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hdms
MONGODB_USER=hdms
MONGODB_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=hdmsminio
MINIO_ROOT_PASSWORD=CHANGE_ME
